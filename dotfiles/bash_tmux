if command -v tmux &> /dev/null && [ -n "$PS1" ] && [ -t 0 ] && [ -t 1 ] && [ -t 2 ] && [[ ! "$TERM" =~ screen ]] && [[ ! "$TERM" =~ tmux ]] && [ -z "$TMUX" ]; then
  if [[ -n "$DEBUG" ]]; then
    echo "Attempting to start tmux. TERM=$TERM, TMUX=$TMUX"
  fi
  # Verify tmux server can start before exec-ing (no fallback after exec)
  if tmux start-server 2>/dev/null; then
    exec tmux new-session -A -s main 2>/dev/null
  else
    echo "[TMUX] tmux start-server failed, falling back to plain shell"
  fi
fi
